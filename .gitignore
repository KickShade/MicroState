# =========================
# Virtual environment
# =========================
.venv/

# =========================
# Python
# =========================
__pycache__/
*.pyc

# =========================
# Data (never tracked)
# =========================
data/

# =========================
# Models
# =========================
# Ignore all models by default
models/**

# Allow production-ready models only
!models/*.txt                 # LightGBM text models
!models/*.pkl                 # Serialized baseline models

# Allow Prophet price context model
!models/price_prediction/
!models/price_prediction/prophet_midprice_15m.pkl

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/
*.ipynb

# =========================
# OS / system
# =========================
.DS_Store

# =========================
# Packaging
# =========================
*.egg-info/

# =========================
# Environment / secrets
# =========================
.env
